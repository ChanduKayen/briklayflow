# Only PUBLIC values may carry the VITE_ prefix — Vite compiles every VITE_ var
# into the browser bundle, so it is readable by anyone who loads the app.
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key   # publishable/anon key ONLY

# NEVER put privileged secrets here or anywhere VITE_-prefixed. The service-role
# key bypasses RLS and AI-provider keys are billable — they belong in Supabase
# function secrets, used only by edge functions (admin-users, ai-briefing):
#   SUPABASE_SERVICE_ROLE_KEY  (auto-injected into edge functions)
#   ANTHROPIC_API_KEY          (supabase secrets set ANTHROPIC_API_KEY=...)

# Briklay's WhatsApp business number (the one site people message).
# Used to render the "Start on WhatsApp" QR + click-to-chat link. Digits only,
# with country code, e.g. 919876543210. If unset, the QR surface explains it
# isn't configured yet instead of showing a broken code.
VITE_BRIKLAY_WA_NUMBER=
